# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Virtual environments
venv/
.venv/
env/

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Test / hypothesis caches
.pytest_cache/
.hypothesis/

# CICIoMT2024 dataset (must be downloaded, see data/README.md)
data/train/*.csv
data/test/*.csv

# Large supervised models are regenerated by `make reproduce-supervised`
# (see PROVENANCE.md). They are intentionally not versioned.
results/models/*.pkl
results/models/*.keras

# Stray runtime logs at the results root (the bundled five-seed autoencoder
# run keeps its own run.log/orchestrator.log as reproducibility evidence).
/results/*.log
/*.log
